# Path penyimpanan data transaksi (format JSON)
# Bisa diisi path absolut atau relatif terhadap folder aplikasi.
# Contoh OneDrive: C:\Users\NamaUser\OneDrive\pos-data
# Contoh relatif: ./pos-data
# Jika kosong atau file .env tidak ada, default: ./pos-data (di folder aplikasi)
DATA_PATH=./pos-data

# Konfigurasi printer
PRINTER_INTERFACE=printer:RP58 Printer

# Header struk (opsional, kecuali STORE_TITLE)
# Jika STORE_TITLE kosong, otomatis fallback ke "Nama Toko"
STORE_TITLE=Nama Toko
STORE_SUBTITLE=Barang Mudo
STORE_ADDRESS=Alamat Toko
STORE_WA=

# Path logo toko (opsional). Bisa absolut atau relatif dari folder aplikasi.
# Contoh: C:\Users\NamaUser\OneDrive\logo-toko.png
# Contoh relatif: ./assets/logo-toko.png
STORE_LOGO_PATH=

# Konfigurasi DOKU QRIS (SNAP Direct API)
# Wajib diisi untuk fitur QRIS dinamis
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_CLIENT_SECRET=
# Isi dengan B2B Access Token (hasil Get Token SNAP), BUKAN API Key doku_key_...
DOKU_ACCESS_TOKEN=
DOKU_MERCHANT_ID=

# Opsional
DOKU_TERMINAL_ID=A01
DOKU_CHANNEL_ID=H2H
DOKU_POSTAL_CODE=
DOKU_FEE_TYPE=
DOKU_QRIS_VALID_MINUTES=15

# Get Token B2B otomatis
# false: aplikasi minta token baru otomatis dan cache token sampai expired
# true: pakai DOKU_ACCESS_TOKEN statis
DOKU_USE_STATIC_TOKEN=false
DOKU_GET_TOKEN_PATH=/authorization/v1/access-token/b2b

# Mode tanda tangan untuk Get Token: RSA_SHA256 (disarankan untuk SNAP) atau HMAC_SHA256
DOKU_TOKEN_SIGNATURE_MODE=RSA_SHA256

# Isi salah satu: inline private key atau path ke file private key .pem
DOKU_PRIVATE_KEY=
DOKU_PRIVATE_KEY_PATH=

# Lebar karakter printer thermal 58mm (untuk garis pembatas)
PRINTER_CHAR_WIDTH=32
